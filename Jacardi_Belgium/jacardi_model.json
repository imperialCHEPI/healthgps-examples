{
    "$comment": "Belgium init — education equations (8 levels) + mother group start + employment static (coefs/knots/pension step) + later ladder coef slots. Pack layout ahead of engine/schema for mother + BE education equations.",
    "ModelName": "JacardiModel",
    "Education": {
        "method": "multinomial_equations_init",
        "coefficients": {
            "name": "education_static_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Category": "integer",
                "Factor": "string",
                "Coefficient": "double"
            }
        },
        "knots": {
            "name": "education_static_knots.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "knot": "integer",
                "age": "integer"
            }
        }
    },
    "MotherGroup": {
        "method": "empirical_mother_group_init",
        "start": {
            "name": "mother_group_start_2025.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "age": "integer",
                "gender": "integer",
                "mother_group_id": "integer",
                "probability": "double"
            }
        }
    },
    "Employment": {
        "method": "multinomial_static",
        "coefficients": {
            "name": "employment_static_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Category": "integer",
                "Factor": "string",
                "Coefficient": "double"
            }
        },
        "knots": {
            "name": "employment_static_knots.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "knot": "integer",
                "age": "integer"
            }
        },
        "pension_step": {
            "name": "employment_pension_step_ages.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "gender": "integer",
                "pension_age": "integer"
            }
        },
        "recode": {
            "name": "employment_4cat_recode.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "employment_id": "integer",
                "employment4_id": "integer"
            }
        }
    },
    "HLS": {
        "method": "linear",
        "coefficients": {
            "name": "hls_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "Smoking": {
        "method": "multinomial",
        "coefficients": {
            "name": "smoking_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Category": "string",
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "PhysicalActivity": {
        "method": "linear",
        "coefficients": {
            "name": "pa_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "BMI": {
        "method": "linear",
        "coefficients": {
            "name": "bmi_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "MedicationAdherence": {
        "method": "logistic",
        "coefficients": {
            "name": "medication_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "SBP": {
        "method": "linear",
        "coefficients": {
            "name": "sbp_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    }
}
