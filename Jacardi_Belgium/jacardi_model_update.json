{
    "$comment": "Belgium update — education Part B (draw19/upgrades + mother-stratified tables) + employment first-at-19 static + yearly employment slots + later ladder yearly slots. Pack layout ahead of engine/schema for mother + yearly employment.",
    "ModelName": "JacardiModelUpdate",
    "Education": {
        "method": "empirical_lifecycle_update",
        "draw_at_19": {
            "name": "education_draw_at_19_ssp2.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "year": "integer",
                "gender": "integer",
                "education_id": "integer",
                "probability": "double"
            }
        },
        "upgrade_transitions": {
            "name": "education_upgrade_transitions_ssp2.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "year": "integer",
                "age": "integer",
                "gender": "integer",
                "from_id": "integer",
                "to_id": "integer",
                "probability": "double"
            }
        }
    },
    "MotherGroup": {
        "method": "empirical_mother_group_update",
        "newborn": {
            "name": "mother_group_newborn_by_year_ssp2.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "year": "integer",
                "gender": "integer",
                "mother_group_id": "integer",
                "probability": "double"
            }
        },
