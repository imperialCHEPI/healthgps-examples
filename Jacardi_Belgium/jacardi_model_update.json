            "name": "education_draw_at_19_by_mother_ssp2.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "year": "integer",
                "gender": "integer",
                "mother_group_id": "integer",
                "education_id": "integer",
                "probability": "double"
            }
        },
        "upgrade_transitions_by_mother": {
            "name": "education_upgrade_transitions_by_mother_ssp2.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "year": "integer",
                "age": "integer",
                "gender": "integer",
                "mother_group_id": "integer",
                "from_id": "integer",
                "to_id": "integer",
                "probability": "double"
            }
        }
    },
