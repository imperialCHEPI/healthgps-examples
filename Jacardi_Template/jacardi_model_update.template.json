{
    "$comment": "JACARDI dynamic / update slot. Yearly CSV paths only (not init lookup). Fill REPLACE_* with country filenames when partners deliver them.",
    "ModelName": "JacardiModelUpdate",
    "Education": {
        "method": "empirical_lifecycle_update",
        "draw_at_22": {
            "name": "REPLACE_education_draw_at_22.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "year": "integer",
                "gender": "integer",
                "education_id": "integer",
                "probability": "double"
            }
        },
        "upgrade_transitions": {
            "name": "REPLACE_education_upgrade_transitions.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "year": "integer",
                "age": "integer",
                "gender": "integer",
                "from_id": "integer",
                "to_id": "integer",
                "probability": "double"
            }
        }
    },
    "Employment": {
        "method": "logistic",
        "coefficients": {
            "name": "REPLACE_employment_update_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "HLS": {
        "method": "linear",
        "coefficients": {
            "name": "REPLACE_hls_update_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "Smoking": {
        "method": "multinomial",
        "coefficients": {
            "name": "REPLACE_smoking_update_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Category": "string",
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "PhysicalActivity": {
        "method": "linear",
        "coefficients": {
            "name": "REPLACE_pa_update_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "BMI": {
        "method": "linear",
        "coefficients": {
            "name": "REPLACE_bmi_update_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "MedicationAdherence": {
        "method": "logistic",
        "coefficients": {
            "name": "REPLACE_medication_update_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "SBP": {
        "method": "linear",
        "coefficients": {
            "name": "REPLACE_sbp_update_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    }
}
