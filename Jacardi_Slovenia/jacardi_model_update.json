{
    "$comment": "Slovenia update slot — education Part B + employment static Part B (first draw at 19 / temporary hold) + yearly coef slots for later ladder steps.",
    "ModelName": "JacardiModelUpdate",
    "Education": {
        "method": "empirical_lifecycle_update",
        "lookup": {
            "name": "education_lookup.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "age": "integer",
                "gender": "integer",
                "education_id": "integer",
                "probability": "double"
            }
        },
        "draw_at_19": {
            "name": "education_draw_at_19_ssp2.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "year": "integer",
                "gender": "integer",
                "education_id": "integer",
                "probability": "double"
            }
        },
        "upgrade_transitions": {
            "name": "education_upgrade_transitions_ssp2.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "year": "integer",
                "age": "integer",
                "gender": "integer",
                "from_id": "integer",
                "to_id": "integer",
                "probability": "double"
            }
        }
    },
    "Employment": {
        "method": "multinomial_static",
        "coefficients": {
            "name": "employment_static_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Category": "integer",
                "Coefficient": "double"
            }
        },
        "recode": {
            "name": "employment_4cat_recode.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "employment_id": "integer",
                "employment4_id": "integer"
            }
        }
    },
    "HLS": {
        "method": "linear",
        "coefficients": {
            "name": "hls_update_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "Smoking": {
        "method": "multinomial",
        "coefficients": {
            "name": "smoking_update_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Category": "string",
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "PhysicalActivity": {
        "method": "linear",
        "coefficients": {
            "name": "pa_update_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "BMI": {
        "method": "linear",
        "coefficients": {
            "name": "bmi_update_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "MedicationAdherence": {
        "method": "logistic",
        "coefficients": {
            "name": "medication_update_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "SBP": {
        "method": "linear",
        "coefficients": {
            "name": "sbp_update_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    }
}
