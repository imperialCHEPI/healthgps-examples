{
    "$comment": "Slovenia init slot — Part A education lookup + employment static (16 Oct 2026) + coef CSV slots for later ladder steps.",
    "ModelName": "JacardiModel",
    "Education": {
        "method": "empirical_lifecycle_init",
        "lookup": {
            "name": "education_lookup.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "age": "integer",
                "gender": "integer",
                "education_id": "integer",
                "probability": "double"
            }
        }
    },
    "Employment": {
        "method": "multinomial_static",
        "coefficients": {
            "name": "employment_static_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Category": "integer",
                "Coefficient": "double"
            }
        },
        "recode": {
            "name": "employment_4cat_recode.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "employment_id": "integer",
                "employment4_id": "integer"
            }
        }
    },
    "HLS": {
        "method": "linear",
        "coefficients": {
            "name": "hls_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "Smoking": {
        "method": "multinomial",
        "coefficients": {
            "name": "smoking_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Category": "string",
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "PhysicalActivity": {
        "method": "linear",
        "coefficients": {
            "name": "pa_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "BMI": {
        "method": "linear",
        "coefficients": {
            "name": "bmi_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "MedicationAdherence": {
        "method": "logistic",
        "coefficients": {
            "name": "medication_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    },
    "SBP": {
        "method": "linear",
        "coefficients": {
            "name": "sbp_coefs.csv",
            "format": "csv",
            "delimiter": ",",
            "encoding": "ASCII",
            "columns": {
                "Factor": "string",
                "Coefficient": "double"
            }
        }
    }
}
